{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "开机记录组件",
  "version": "2.0.1",
  "identifier": "com.boottracker.widget",
  "build": {
    "frontendDist": "widget-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "widget",
        "title": "开机记录组件",
        "width": 230,
        "height": 116,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
