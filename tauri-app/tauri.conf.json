{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/config.schema.json",
  "productName": "开机记录",
  "version": "2.1.0",
  "identifier": "com.boottracker.app",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://127.0.0.1:5174",
    "beforeDevCommand": "cd ui && trunk serve",
    "beforeBuildCommand": "cd ui && trunk build --release"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "开机记录",
        "label": "main",
        "width": 960,
        "height": 760,
        "minWidth": 700,
        "minHeight": 500,
        "center": true,
        "decorations": true,
        "transparent": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
